# Copie para .env e ajuste. NUNCA versione o .env.
DATABASE_URL=postgresql+psycopg://talentmatch:talentmatch@postgres:5432/talentmatch
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini-2024-07-18
# Formato: client_id:secret,client_id2:secret2  (gere secrets longos: openssl rand -hex 32)
API_KEYS=dev:troque-por-um-segredo-longo
RETENTION_DAYS=180

# --- Provedores alternativos (OpenAI-compatíveis). Confirme nomes de modelo e termos na documentação atual. ---
# OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<provedor/modelo>   LLM_STRUCTURED_MODE=json_object
# Google Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=<modelo gemini>
# Se o provedor rejeitar o parâmetro seed: LLM_SEND_SEED=false
# ATENÇÃO: camadas gratuitas podem usar o conteúdo para treino. Use SOMENTE currículos sintéticos nelas.
